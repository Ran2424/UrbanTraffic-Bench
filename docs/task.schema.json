{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UrbanTraffic-Bench task v2",
  "type": "object",
  "required": [
    "task_id",
    "scenario",
    "question",
    "supplementary_notes",
    "output_contract",
    "gold_sql",
    "difficulty",
    "legacy_task_id"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^(S(0[1-9]|[1-3][0-9]|40)|[XG](0[1-9]|[12][0-9]|30))$"
    },
    "scenario": {
      "enum": [
        "single_mode",
        "cross_modal",
        "spatial_gis"
      ]
    },
    "difficulty": {
      "enum": [
        "简",
        "中",
        "难"
      ]
    },
    "legacy_task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "supplementary_notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "output_contract": {
      "type": "object",
      "required": [
        "columns"
      ],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "type",
              "nullable"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": [
                  "integer",
                  "number",
                  "text"
                ]
              },
              "nullable": {
                "type": "boolean"
              },
              "decimal_places": {
                "type": "integer",
                "minimum": 0
              },
              "minimum_decimal_places": {
                "type": "integer",
                "minimum": 0
              },
              "allowed_values": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "row_selection": {
          "type": "object",
          "properties": {
            "mode": {
              "const": "fixed_top_k"
            },
            "tie_break": {
              "type": "string"
            }
          }
        }
      }
    },
    "gold_sql": {
      "type": "string",
      "minLength": 1
    }
  }
}
