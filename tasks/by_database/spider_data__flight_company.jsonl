{"task_id": "task_000510", "source": "spider_data", "split": "train", "db_id": "flight_company", "database_uid": "spider_data__flight_company", "scenario": "aviation_airport", "scenario_zh": "机场航空", "question": "What is the id, name and IATA code of the airport that had most number of flights?", "gold_sql": "WITH airport_counts AS (SELECT a.id, a.name, a.IATA, COUNT(*) AS flight_count FROM airport AS a JOIN flight AS f ON a.id = f.airport_id GROUP BY a.id, a.name, a.IATA) SELECT id, name, IATA FROM airport_counts WHERE flight_count = (SELECT MAX(flight_count) FROM airport_counts) ORDER BY id", "evidence": null, "original_sample_index": 509, "original_source_path": "spider_data/train_spider_traffic.json", "schema_ref": "schemas/by_database/spider_data__flight_company.json", "schema_markdown_ref": "schemas/by_database/spider_data__flight_company.md", "knowledge_ref": "knowledge/by_database/spider_data__flight_company_knowledge_database.md", "execution_status": "ok", "result_mode": "full_rows", "result_columns": ["id", "name", "IATA"], "result_row_count": 2, "verification_sql": null, "verification_result_row_count": null, "is_corrected": true, "correction_category": "Gold SQL 分组错误 / 并列口径修复", "correction_type": "sql", "correction_reason": "题目要求航班数量最多的机场，原 Gold 按 flight id 分组，无法统计机场航班数。修复版按 airport 分组，并返回所有并列最多的机场。", "original_question": "What is the id, name and IATA code of the airport that had most number of flights?", "original_gold_sql": "SELECT T1.id ,  T1.name ,  T1.IATA FROM airport AS T1 JOIN flight AS T2 ON T1.id  =  T2.airport_id GROUP BY T2.id ORDER BY count(*) DESC LIMIT 1"}
