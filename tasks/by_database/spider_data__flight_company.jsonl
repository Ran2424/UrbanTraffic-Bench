{"task_id": "task_000516", "source": "spider_data", "split": "train", "db_id": "flight_company", "database_uid": "spider_data__flight_company", "scenario": "aviation_airport", "scenario_zh": "机场航空", "question": "How many companies operates airlines in each airport?", "gold_sql": "SELECT a.id, COUNT(DISTINCT f.company_id) AS company_count FROM airport AS a LEFT JOIN flight AS f ON a.id = f.airport_id GROUP BY a.id ORDER BY a.id", "evidence": null, "original_sample_index": 515, "original_source_path": "spider_data/train_spider_traffic.json", "schema_ref": "schemas/by_database/spider_data__flight_company.json", "schema_markdown_ref": "schemas/by_database/spider_data__flight_company.md", "knowledge_ref": "knowledge/by_database/spider_data__flight_company_knowledge_database.md", "execution_status": "ok", "result_mode": "full_rows", "result_columns": ["id", "company_count"], "result_row_count": 9, "verification_sql": null, "verification_result_row_count": null, "is_corrected": true, "correction_category": "Gold SQL 计数口径错误", "correction_type": "sql", "correction_reason": "题目问每个机场有多少 operating companies，原 Gold 统计 flight 行数。修复版从 airport 出发，统计 DISTINCT company_id，并保留没有航班公司的机场为 0。", "original_question": "How many companies operates airlines in each airport?", "original_gold_sql": "SELECT T3.id ,  count(*) FROM operate_company AS T1 JOIN flight AS t2 ON T1.id  =  T2.company_id JOIN airport AS T3 ON T2.airport_id  =  T3.id GROUP BY T3.id"}
