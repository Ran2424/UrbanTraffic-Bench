{"task_id": "task_000867", "source": "spider_data", "split": "test", "db_id": "vehicle_rent", "database_uid": "spider_data__vehicle_rent", "scenario": "road_vehicle_business", "scenario_zh": "道路车辆", "question": "Show the name and total hours of renting for each vehicle.", "gold_sql": "SELECT v.name, COALESCE(SUM(r.total_hours), 0) AS total_rental_hours FROM vehicles AS v LEFT JOIN renting_history AS r ON r.vehicles_id = v.id GROUP BY v.id, v.name ORDER BY v.id", "evidence": null, "original_sample_index": 70, "original_source_path": "spider_data/test_traffic.json", "schema_ref": "schemas/by_database/spider_data__vehicle_rent.json", "schema_markdown_ref": "schemas/by_database/spider_data__vehicle_rent.md", "knowledge_ref": "knowledge/by_database/spider_data__vehicle_rent_knowledge_database.md", "execution_status": "ok", "result_mode": "full_rows", "result_columns": ["name", "total_rental_hours"], "result_row_count": 7, "verification_sql": null, "verification_result_row_count": null, "is_corrected": true, "correction_category": "题目本身有问题 / 评测标准偏严", "correction_type": "sql", "correction_reason": "题目说 each vehicle，应包含没有租赁记录的车辆。原 Gold 用 INNER JOIN 只统计有 renting_history 的车辆；修复版 LEFT JOIN，并将空租赁时长记为 0。", "original_question": "Show the name and total hours of renting for each vehicle.", "original_gold_sql": "SELECT T2.name ,  sum(T1.total_hours) FROM renting_history AS T1 JOIN vehicles AS T2 ON T1.vehicles_id  =  T2.id GROUP BY T2.id"}
