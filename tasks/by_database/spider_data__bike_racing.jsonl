{"task_id": "task_001103", "source": "spider_data", "split": "test", "db_id": "bike_racing", "database_uid": "spider_data__bike_racing", "scenario": "racing_competition", "scenario_zh": "赛车竞赛", "question": "How many bikes does each cyclist own? Order by cyclist id.", "gold_sql": "SELECT c.id, COUNT(cob.bike_id) AS bike_count FROM cyclist AS c LEFT JOIN cyclists_own_bikes AS cob ON c.id = cob.cyclist_id GROUP BY c.id ORDER BY c.id", "evidence": null, "original_sample_index": 306, "original_source_path": "spider_data/test_traffic.json", "schema_ref": "schemas/by_database/spider_data__bike_racing.json", "schema_markdown_ref": "schemas/by_database/spider_data__bike_racing.md", "knowledge_ref": "knowledge/by_database/spider_data__bike_racing_knowledge_database.md", "execution_status": "ok", "result_mode": "full_rows", "result_columns": ["id", "bike_count"], "result_row_count": 8, "verification_sql": null, "verification_result_row_count": null, "is_corrected": true, "correction_category": "题目本身有问题 / 评测标准偏严", "correction_type": "sql", "correction_reason": "题目说 each cyclist，原 Gold 只统计 cyclists_own_bikes 中出现的 cyclist；修复版从 cyclist 出发 LEFT JOIN，并按 cyclist id 排序。", "original_question": "How many bikes does each cyclist own? Order by cyclist id.", "original_gold_sql": "SELECT cyclist_id ,  count(*) FROM cyclists_own_bikes GROUP BY cyclist_id ORDER BY cyclist_id"}
