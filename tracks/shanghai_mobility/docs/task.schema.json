{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shanghai multimodal Text-to-SQL task v2",
  "type": "object",
  "required": [
    "task_id",
    "scenario",
    "question",
    "gold_sql",
    "difficulty",
    "legacy_task_id"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^(S(0[1-9]|[1-3][0-9]|40)|[XG](0[1-9]|[12][0-9]|30))$"
    },
    "scenario": {
      "enum": [
        "single_mode",
        "cross_modal",
        "spatial_gis"
      ]
    },
    "difficulty": {
      "enum": [
        "简",
        "中",
        "难"
      ]
    },
    "legacy_task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "gold_sql": {
      "type": "string",
      "minLength": 1
    }
  }
}
